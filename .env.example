[TEMPLATE]
# Rentalio — contoh environment. Salin ke .env lalu isi nilainya.
# Jangan pernah commit .env atau membagikan connection string.

# --- Database (Supabase PostgreSQL) ---
# Runtime memakai transaction pooler Supabase (port 6543) dengan role
# non-BYPASSRLS `sewain_dev`; username pooler = `sewain_dev.<project-ref>`.
# Migrasi memakai session pooler/direct (port 5432) dengan `sewain_migrator`.
# Jalankan database/sql/supabase-bootstrap.sql lebih dulu; lihat
# docs/deploy-supabase-vercel.md.
#
# @prisma/adapter-pg tidak meng-cache prepared statement, jadi aman untuk
# Supavisor transaction mode. Parameter `pgbouncer=true` tidak diperlukan.
#
# `uselibpqcompat=true` wajib pada DATABASE_URL: sejak pg 8.16 `sslmode=require`
# diperlakukan seperti `verify-full`, sedangkan sertifikat pooler Supabase
# ditandatangani CA privat (`Supabase Root 2021 CA`) sehingga driver menolak
# koneksi dengan SELF_SIGNED_CERT_IN_CHAIN. Flag itu mengembalikan semantik
# libpq: koneksi tetap terenkripsi, tetapi sertifikat server tidak diverifikasi.
DATABASE_URL=postgresql://sewain_dev.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true&schema=public
# PENTING: CLI Prisma memprioritaskan DIRECT_URL. Saat mengembangkan di
# PostgreSQL lokal, kosongkan DIRECT_URL (fallback ke DATABASE_URL lokal)
# atau pakai file env terpisah; jangan arahkan migrate dev ke produksi.
DIRECT_URL=postgresql://sewain_migrator.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&schema=public
# Ukuran pool pg per instance. Vercel serverless: 1. Server lokal: 10.
DATABASE_POOL_MAX=10
#
# Development lokal tanpa Supabase (opsional, cukup isi salah satu):
# DATABASE_URL=postgresql://sewain_dev@localhost:5432/sewain_dev?schema=public

# --- API ---
NODE_ENV=development
PORT=3000
# Origin frontend untuk CORS allowlist + validasi Origin/Referer (CSRF).
# Di production tambahkan pola subdomain tenant, mis.:
# CORS_ORIGINS=https://rentalio.my.id,https://admin.rentalio.my.id,https://*.rentalio.my.id
CORS_ORIGINS=http://localhost:3001
APP_BASE_URL=http://localhost:3001

# --- Admin Platform (aplikasi terpisah, origin sendiri) ---
# Origin aplikasi admin. Dipakai sebagai satu-satunya Origin yang sah untuk
# mutasi cookie admin (CSRF) dan wajib HTTPS di production. Aplikasi admin
# memanggil API lewat proxy same-origin agar cookie admin tetap host-only.
PLATFORM_ADMIN_BASE_URL=http://localhost:3002
# Kunci AES-256-GCM (base64 dari tepat 32 byte) khusus untuk enkripsi secret
# TOTP admin. Terpisah dari HMAC_PEPPER. Wajib di production.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_ADMIN_ENCRYPTION_KEY=

# --- Keamanan ---
# Pepper HMAC untuk hash OTP/token. Minimal 32 karakter.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HMAC_PEPPER=
# Cookie sesi Secure (otomatis true di production; TLS wajib).
COOKIE_SECURE=false
# Domain cookie sesi. Kosongkan di lokal (host-only). Di production isi domain
# platform agar sesi ikut berlaku di subdomain tenant, mis. SESSION_COOKIE_DOMAIN=rentalio.my.id
SESSION_COOKIE_DOMAIN=

# --- Cron serverless (Vercel) ---
# Wajib bila memakai endpoint /api/v1/internal/cron di Vercel. Vercel Cron
# mengirim `Authorization: Bearer <CRON_SECRET>`. Kosong = endpoint menolak
# semua request. Hasilkan dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Token terpisah untuk endpoint status cron (opsional; fallback CRON_SECRET).
CRON_STATUS_TOKEN=
# Penerima alert kegagalan cron (opsional; fallback PLATFORM_OPERATOR_EMAIL).
CRON_ALERT_EMAIL=
# Jeda minimum antar-alert kegagalan cron (detik, default 3600).
CRON_ALERT_COOLDOWN_SECONDS=3600
# Umur maksimum run terakhir sebelum status dianggap stale (detik, default 300).
CRON_STALE_AFTER_SECONDS=300

# --- Email (OTP/reset) ---
# dev-file: tulis ke .dev-mailbox/ (hanya development).
# in-memory: untuk test otomatis.
# resend: kirim lewat Resend API (wajib di production).
EMAIL_PROVIDER=dev-file
# Wajib bila EMAIL_PROVIDER=resend. Hanya server-side; jangan commit nilainya.
# Dapat dari: https://resend.com/api-keys
RESEND_API_KEY=
# Alamat pengirim. Production wajib memakai domain yang terverifikasi di Resend
# beserta SPF/DKIM dan kebijakan DMARC. Default: Rentalio <onboarding@resend.dev>
EMAIL_FROM=
# Nama/alias template Resend untuk email OTP (harus berstatus published).
# Kosongkan untuk mengirim teks polos. Default: verifrentalio-resend
# Variabel yang dipakai template: user_name, otp_code, otp_expiry_minutes.
RESEND_OTP_TEMPLATE=verifrentalio-resend

# --- Cloudflare R2 (Object Storage) ---
# Account ID: Cloudflare Dashboard → kanan bawah "Account ID"
R2_ACCOUNT_ID=
# API Token R2: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Beri izin Object Read & Write pada bucket target.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nama bucket R2 yang sudah dibuat
R2_BUCKET_NAME=rentalio
# URL publik bucket. Aktifkan "Public Access" di R2 atau hubungkan custom domain.
# Contoh r2.dev: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Contoh custom domain: https://storage.domainkamu.com
R2_PUBLIC_URL=

# --- Billing langganan (QRIS dinamis) ---
# Payload QRIS STATIS milik merchant Rentalio (string EMVCo dari aplikasi
# bank/e-wallet, diawali "000201"). API mengubahnya menjadi QRIS dinamis yang
# sudah memuat nominal tagihan. Kosong = pembayaran langganan dinonaktifkan dan
# UI kembali ke jalur manual (hubungi tim Rentalio).
#
# PENTING: QRIS dinamis tidak punya callback. Status lunas TIDAK berubah
# otomatis; operator platform menandainya lewat Admin Platform
# (permission `platform.subscriptions.settle`) setelah dana terverifikasi.
PLATFORM_QRIS_STATIC_PAYLOAD=
# Masa berlaku tagihan (detik). Default 24 jam.
SUBSCRIPTION_INVOICE_DURATION_SECONDS=86400
# Harga langganan per periode (IDR utuh). 0 = belum diatur → endpoint pembuatan
# tagihan menolak dengan 503 BILLING_NOT_CONFIGURED (tidak mengarang harga).
SUBSCRIPTION_PRICE_AMOUNT=0
# Panjang periode yang ditambahkan setelah pembayaran dinyatakan lunas.
SUBSCRIPTION_PERIOD_DAYS=30

# --- Pengingat Tagihan ke Operator ---
# QRIS tidak punya callback, jadi pembayaran diverifikasi manual. Proses worker
# mengirim email pengingat ke operator saat ada tagihan PENDING. Kosong =
# pengingat dinonaktifkan (tidak ada email keluar).
PLATFORM_OPERATOR_EMAIL=
# Nyala eksplisit; proses worker men-set true bila variabel tidak ada.
BILLING_REMINDER_ENABLED=false
# Interval antar-putaran (default 5 menit).
BILLING_REMINDER_INTERVAL_MS=300000
# Jumlah tagihan yang diperiksa per putaran.
BILLING_REMINDER_BATCH_SIZE=50
# Umur minimum tagihan (detik) sebelum pengingat pertama dikirim, supaya
# penyewa diberi kesempatan membayar dulu. Default 10 menit.
BILLING_REMINDER_MIN_AGE_SECONDS=600
# Sisa waktu (detik) ke expiresAt yang memicu pengingat "mendekati kedaluwarsa".
BILLING_REMINDER_EXPIRY_WINDOW_SECONDS=3600

# --- Rate Limit ---
# Pengali batas rate limit (default 1 = angka kontrak auth).
# Dokumen 10: "Ambang maksimum request per jangka waktu ... merupakan
# parameter konfigurasi". Nilai > 1 dipakai test agar suite biasa tidak
# saling menghambat pada bucket IP yang sama.
RATE_LIMIT_SCALE=1

# --- Worker Outbox ---
# API tidak menjalankan worker. Proses worker (`pnpm --filter @rentalio/api worker`)
# menyalakan job ini secara default bila variabel tidak di-set; set false untuk
# mematikannya. Worker memakai konteks sistem `app.outbox_system` (policy
# migration 009), bukan tenant context, dan bersifat at-least-once: handler
# wajib idempoten.
OUTBOX_WORKER_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
# Lease klaim; setelah ini baris yang tertinggal boleh diklaim worker lain.
OUTBOX_LEASE_MS=60000
OUTBOX_BACKOFF_BASE_MS=5000
OUTBOX_BACKOFF_MAX_MS=300000

# --- Reconciler Subscription ---
# Berjalan hanya di proses worker dan default nyala di sana bila variabel tidak
# di-set; set false untuk mematikannya. Job memakai konteks baca
# `app.subscription_reconciler` (policy migration 015) dan menulis transisi di
# konteks tenant masing-masing.
SUBSCRIPTION_RECONCILER_ENABLED=false
# Interval antar-putaran (default 15 menit).
SUBSCRIPTION_RECONCILE_INTERVAL_MS=900000
# Jumlah subscription due yang diproses per putaran.
SUBSCRIPTION_RECONCILE_BATCH_SIZE=200

# --- Frontend (apps/web & apps/admin) ---
# Target proxy server-side `/api/v1/*`. Dibaca saat build Next.js (rewrites),
# jadi perubahan memerlukan redeploy. Di Vercel isi URL API production.
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
# Domain root katalog tenant (wildcard). Katalog hanya disajikan di subdomain tenant.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=rentalio.my.id
# Nomor WhatsApp dukungan pada halaman pengaturan (server-side, opsional).
SUPPORT_WHATSAPP=
