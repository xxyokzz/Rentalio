{
  "name": "@rentalio/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "admin:bootstrap": "tsx src/platform-admin/platform-admin-bootstrap.cli.ts",
    "admin:seed": "tsx src/platform-admin/platform-admin-default.cli.ts",
    "worker": "node --watch dist/worker.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run test/integration",
    "test:integration:watch": "vitest test/integration",
    "test:e2e:resend": "vitest run --config vitest.e2e.config.ts test/e2e/resend.e2e.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/swagger": "11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@rentalio/database": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "resend": "^6.34.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.0.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "3.2.4"
  }
}
