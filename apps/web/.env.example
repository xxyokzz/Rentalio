[TEMPLATE]
# Rentalio — environment frontend (`apps/web`). Salin ke `.env.local`.
# Jangan pernah menaruh secret backend (RESEND_API_KEY, DATABASE_URL,
# HMAC_PEPPER, kredensial R2) di sini: semua nilai NEXT_PUBLIC_* masuk bundle.

# URL backend yang dipakai rewrite `/api/v1/*` (server-side, tidak bocor ke browser).
API_INTERNAL_URL=http://localhost:3000

# Origin aplikasi ini; dipakai untuk metadata/tautan absolut.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Domain platform: subdomain langsung di bawahnya dibaca sebagai slug tenant
# (`demo.rentalio.my.id` → tenant `demo`). Domain kustom tenant tidak perlu didaftar
# di sini; resolusinya lewat API (`/public/resolve-host`) dan tabel tenant_domains.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=rentalio.my.id

# Mode demo katalog publik: slug tenant default untuk `/katalog` bila host bukan
# subdomain tenant maupun domain kustom. Kosongkan bila memakai custom domain.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=

# Nomor WhatsApp tim Rentalio (digit, tanpa "+") untuk pengajuan perpanjangan/
# upgrade langganan di halaman Pengaturan usaha. Tanpa prefix NEXT_PUBLIC_:
# dibaca server saat request dirender, jadi mengganti nomor cukup mengubah
# environment dan me-restart proses — tanpa build ulang. Kosongkan bila belum
# ada nomor: tautan akan membuka pemilih kontak WhatsApp tanpa tujuan.
SUPPORT_WHATSAPP=
