# Rentalio — environment Admin Platform (`apps/admin`). Salin ke `.env.local`.
# Aplikasi ini tidak menyimpan secret apa pun: seluruh autentikasi, sesi, dan
# otorisasi ditegakkan oleh API. Jangan menaruh RESEND_API_KEY, DATABASE_URL,
# HMAC_PEPPER, atau PLATFORM_ADMIN_ENCRYPTION_KEY di sini.

# URL backend yang dipakai rewrite `/api/v1/*` (server-side, tidak bocor ke browser).
API_INTERNAL_URL=http://localhost:3000

# Origin aplikasi admin ini; dipakai untuk metadata/tautan absolut.
# Wajib sama dengan PLATFORM_ADMIN_BASE_URL di backend, karena guard CSRF
# membandingkan header Origin secara persis.
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
